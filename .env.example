# GitHub API Configuration
# Scoped Personal Access Token limited only to your owned fork / test repo
GITHUB_TOKEN=ghp_your_github_token_here
GITHUB_OWNER=your_github_username
GITHUB_DEFAULT_FORK=your_github_username/autopatch-ai

# LLM Configuration (LiteLLM)
# Models are configured via environment variables to allow tiering
MODEL_STRONG=anthropic/claude-3-5-sonnet-20241022
MODEL_CHEAP=anthropic/claude-3-5-haiku-20241022
MODEL_REVIEWER=openai/gpt-4o-mini
ANTHROPIC_API_KEY=sk-ant-placeholder
OPENAI_API_KEY=sk-placeholder

# Cost Limits (USD)
HARD_COST_CAP_PER_RUN=2.50

# Docker Sandbox Settings
DOCKER_IMAGE_NAME=clarify-or-code-sandbox:latest
SANDBOX_TIMEOUT_SECONDS=180
SANDBOX_MAX_MEMORY=2g
SANDBOX_MAX_CPUS=2.0
SANDBOX_MAX_PIDS=100

# SQLite Checkpointer
CHECKPOINT_DB_PATH=./checkpoints.sqlite

# Logging
LOG_LEVEL=INFO
